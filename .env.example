# ==============================================================================
# Bangladesh Multi-Tenant Pharmacy ERP & POS - Backend Environment Template
# Architecture Decision: ADR-0022 (Backend Environment Isolation & Lock Policy)
# ==============================================================================
# IMPORTANT:
# 1. Never commit live secrets, production passwords, or API keys to version control.
# 2. Copy this file to .env and replace placeholders with secure environment values.
# 3. Minimum Python runtime: Python >= 3.13.0, < 3.14.0.
# ==============================================================================

# Runtime Environment (development | staging | production | test)
ENVIRONMENT=development

# Django Core Security
DJANGO_SECRET_KEY=generate_secure_random_key_min_32_chars_for_production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (postgres for cloud authority / staging / prod; sqlite for local offline dev)
DB_ENGINE=postgres
POSTGRES_DB=pharmacy_erp_db
POSTGRES_USER=pharmacy_user
POSTGRES_PASSWORD=replace_with_strong_password_in_env
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache & Celery Background Tasks
REDIS_URL=redis://localhost:6379/0

# JWT Authentication (Must be distinct from DJANGO_SECRET_KEY and at least 32 characters)
JWT_SIGNING_KEY=generate_distinct_jwt_secret_key_min_32_chars_ad022

# Localization & Timezone
TIME_ZONE=Asia/Dhaka
LANGUAGE_CODE=en-us

# CORS & Gateway Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
BACKEND_PORT=8000

