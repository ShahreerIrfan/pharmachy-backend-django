# .editorconfig - Bangladesh Multi-Tenant Pharmacy ERP & POS SaaS
# Architecture Decision: ADR-0026
# Universal multi-language formatting baseline

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.py]
indent_style = space
indent_size = 4

[*.java]
indent_style = space
indent_size = 4

[*.dart]
indent_style = space
indent_size = 2

[*.{json,json5}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{xml,fxml,html}]
indent_style = space
indent_size = 4

[*.css]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

